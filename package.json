{
  "name": "dsh-honcho-memory-viz",
  "version": "1.0.0",
  "description": "Honcho memory explorer for the DeepSeek Harness Web UI: browse peers, conclusions, sessions and a relationship graph, with semantic search.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "honcho",
    "memory",
    "visualization",
    "knowledge-graph"
  ],
  "license": "MIT",
  "author": "Lei (leixlabs) <kamalei.zhang@gmail.com>",
  "homepage": "https://github.com/leixlabs/dsh-honcho-memory-viz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leixlabs/dsh-honcho-memory-viz.git"
  },
  "bugs": {
    "url": "https://github.com/leixlabs/dsh-honcho-memory-viz/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests/*.mjs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node tests/smoke-client.mjs && node tests/render-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  }
}
